<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<title>Campus Bakery Online Order</title>
</head>

<body>
<div id ="header">
<h1>Campus <span>Bakery</span></h1>
<p>Welcome to Online Order Bakery</p>
</div>

<div id="nav">
	<a href="#home">Home</a> |
	<a href="#menu">Menu</a> |
	<a href="#order">Order</a> |
	<a href="#contact">Contact</a>
</div>

<div id="content">

<h2 id="home">Welcome to Q's Bakery</h2>
<p>Enjoy our <strong>freshly baked</strong> cakes and cupcakes. We offer
<em>delicious</em> treats at <mark>affordable prices</mark>. 
Order your favourite pastries today! </p>

<h3 id="menu">Our products</h3>
<p><strong>Cupcakes<br> Cake Slices</strong></p>

<hr>
<h2 id="order">Order Form</h2>
<form action="#" method="get">

<!-- Customer Name -->
<label for="name">Customer Name:</label>
<input type="text" id="name" name="name" placeholder="Enter your name" required autofocus>
<br><br>

<!-- Phone Number -->
<label for="phone">Phone Number:</label>
<input type="tel" id="phone" name="phone" required>
<br><br>

<!-- Email Address -->
<label for="email">Email:</label>
<input type="email" id="email" name="email" required>
<br><br>

<!-- Pickup Date -->
<label for="date">Pickup Date:</label>
<input type="date" id="date" name="date" min="2027-02-19">
<br><br>

 <!-- Flavor Selection -->
<label for="flavor">Choose Flavor:</label>
<input list="flavors" id="flavor" name="flavor">

<datalist id="flavors">
	<option value="Chocolate">
	<option value="Vanilla">
	<option value="Strawberry">
	<option value="Red velvet">
	</datalist>
<br><br>

<!-- Icing Colour -->
<label for="colour">Icing Colour:</label>
<input type="color" id="colour" name="colour"> <br><br>

<!-- Sweetness Level -->
<label for="sweetness">Sweetness Level:</label>
<input type="range" id="sweetness" name="sweetness" min="1" max="5" step="1">
<br><br>

<!-- 5. Price Calculator -->
<h3>Price Calculator</h3>

<label for="cupcakes"> Cupcakes (RM 3.00 each):</label>
<input type="number" id="cupcakes" name="cupcakes" min="0" value="0" oninput="calculateTotal()">
<br><br>

<label for="cakes"> Cake Slices (RM 5.00 each):</label>
<input type="number" id="cakes" name="cakes" min="0" value="0" oninput="calculateTotal()">
<br><br>

<label for="total">Total Price (RM):</label>
<output id="total" name="total" for="cupcakes cakes">0.00</output>
<br><br>

<!-- Submit Button -->
<input type="submit" value="Submit Order">

</form>
</div>

<!-- 6. Sidebar Section -->
<div id="sidebar">
<h3>Price List</h3>
        <ul>
            <li>Cupcakes &ndash; RM 3.00</li>
            <li>Cake Slices &ndash; RM 5.00</li>
        </ul>
<p>Orders &gt; 10 pieces get a free drink</p>
<p>Special offer &amp; discounts available</p>

</div>

<!-- 7. Footer Section -->
<div id="footer">

<hr>
        <p id="contact"> Contact us: qsbakery@example.com</p>

        <p>&copy; 2026 Q's Bakery. All Rights Reserved.</p>
</div>

<!-- JavaScript for Price Calculator -->
<script>
function calculateTotal() {
let cupcakes =
	Number(document.getElementById("cupcakes").value);

let cakes =
	Number(document.getElementById("cakes").value);

let total = (cupcakes * 3) + (cakes * 5);

document.getElementById("total").value = total.toFixed(2);
	}
    </script>

</body>
</html>
