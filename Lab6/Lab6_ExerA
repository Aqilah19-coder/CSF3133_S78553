<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<title>Rock, paper,Scissors</title>
	<link rel="stylesheet" href="style.css">
</head>
<body>
<header>
	<h1> Rock, Paper, Scissors</h1>
	<p>Enter your name, click Start Game, then choose Rock, Paper or Scissors.</p>
</header>

<!--Player section-->
<section>
	<label for="playerName">Your Name:</label>
	<input type="text" id="playerName">
	<button type="button" onclick="startGame()">Start Game</button>
	<p id="welcome"></p>
</section>

<!--Game section-->
<section>
	<button onclick="playRound('rock')">Rock</button>
	<button onclick="playRound('paper')">Paper</button>
	<button onclick="playRound('scissors')">Scissors</button>

	<div class="choices">
	<div>
		<h3>You</h3>
		<img id="playerImg" src="rock.png" alt="Your choice">
	</div>
	<h2>VS</h2>
	<div>
		<h3>Computer</h3>
		<img id="computerImg" src="rock.png" alt="Computer choice">
	</div>
	</div>
</section>

<!--Result and scoreboard section-->
<section>
	<p id="result"></p>
	<p>
		Wins: <span id="wins">0</span>
		Losses: <span id="losses">0</span>
		Draws: <span id="draws">0</span>
	</p>
</section>

<!--History section-->
<section>
	<h2>History</h2>
	<table id="history">
	
	<thead>
	<tr>
		<th>Round</th>
		<th>You</th>
		<th>Computer</th>
		<th>Result</th>
	</tr>
	</thead>

	<tbody id="historyBody"></tbody>
	</table>
	<br>

	<button onclick="showSummary()">Show Summary</button>
	<button onclick="resetGame()">Reset</button>

	<p id="summary"></p>
</section>

<!--Footer section-->
<footer>
	<p id="startTime"></p>
	<p>&copy; 2026 Computer Science Club</p>
</footer>

<!--External Javascript-->
<script src="game.js"></script>

</body>
</html>
