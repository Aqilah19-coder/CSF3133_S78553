<!--REGISTRATION FORM-->
<h2>Registration Form</h2>
<form action="register.html" method="post">
	<label for="fname">First name:</label><br>
	<input type="text" id="fname" name="firstname"><br><br>

	<label for="lname">Last name:</label><br>
	<input type="text" id="lname" name="lastname"><br><br>
	
	<label for="matric">Matric:</label><br>
	<input type="text" id="matric" name="matricnumber"><br><br>

	<label for="email">Email:</label><br>
	<input type="email" id="email" name="email"><br><br>
	
	<label for="year1">Year of study:</label><br>
	<input type="radio" id="year1" name="year" value="Year 1">
	<label for="year1">Year 1</label><br>
	<input type="radio" id="year2" name="year" value="Year 2">
	<label for="year2">Year 2</label><br>
	<input type="radio" id="year3" name="year" value="Year 3">
	<label for="year3">Year 3</label><br>
	<input type="radio" id="year4" name="year" value="Year 4">
	<label for="year4">Year 4</label><br>

	<label>Select the session(s) you'd like to join:</label><br>
	<input type="checkbox" id="session1" name="sessions" value="Session 1">
	<label for="session1">Session 1</label><br>
	<input type="checkbox" id="session2" name="sessions" value="Session 2">
	<label for="session2">Session 2</label><br>
	<input type="checkbox" id="session3" name="sessions" value="Session 3">
	<label for="session3">Session 3</label><br><br>

	<label for="faculty">Choose your faculty:</label>
	<select id="faculty" name="faculty">
		<option value="fskm">FSKM</option>
		<option value="fpm">FPM</option>
		<option value="fsma">FSMA</option>
		<option value="fspa">FSPA</option>

	</select><br><br>
	<input type="submit" value="Submit">
</form>

